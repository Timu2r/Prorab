# Скопируйте в .env и заполните.

PORT=4100

# Пусто — встроенный PostgreSQL (PGlite) в папке data/pg, для разработки.
# На сервере: postgres://user:password@host:5432/klimat
DATABASE_URL=

# Номера владельцев через запятую: при входе с этого номера выдаётся роль «Владелец».
OWNER_PHONES=+79990000000

# Адреса сайта, которым разрешено обращаться к API.
WEB_ORIGINS=http://localhost:5190

# 1 — сервер возвращает код входа в ответе (только для разработки, пока нет провайдера звонков).
DEV_CODES=1

# Папка для фото. Пусто — data/uploads рядом с сервером.
UPLOADS_DIR=

# Секреты: подпись кодов входа и ссылок на фото. На боевом сервере обязательны — длинные случайные строки.
CODE_SECRET=
FILE_SIGN_SECRET=
