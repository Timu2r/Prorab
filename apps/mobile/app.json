{
  "expo": {
    "name": "Отвес",
    "slug": "klimat-servis",
    "version": "0.1.0",
    "scheme": "klimatservis",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.klimatservis.app"
    },
    "android": {
      "package": "ru.klimatservis.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Отвес",
      "shortName": "Отвес",
      "lang": "ru",
      "themeColor": "#17191c",
      "backgroundColor": "#f3f1ec"
    }
  }
}
